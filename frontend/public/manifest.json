{
  "manifest_version": 3,
  "name": "Tab Group Saver",
  "version": "1.0.0",
  "description": "Save current tabs as named groups (e.g., Monday, Work, Research) and restore them later",
  "action": {
    "default_popup": "index.html",
    "default_title": "Tab Group Saver"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": ["<all_urls>"]
}